{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "Cobblemon: Battle Showdown",
  "description": "Adds a team preview before PvP battles: see your rival's team and pick your lead Pokémon.",
  "authors": [
    "saultsc"
  ],
  "contact": {
    "issues": "https://github.com/saultsc/battle_showdown/issues",
    "sources": "https://github.com/saultsc/battle_showdown"
  },
  "license": "MPL-2.0",
  "icon": "assets/${mod_id}/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "value": "saultsc.battle_showdown.fabric.BattleShowdownFabric",
        "adapter": "kotlin"
      }
    ],
    "client": [
      {
        "value": "saultsc.battle_showdown.fabric.client.BattleShowdownFabricClient",
        "adapter": "kotlin"
      }
    ]
  },
  "mixins": [
    "mixins.${mod_id}.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "fabric-language-kotlin": "*",
    "minecraft": "1.21.1",
    "java": ">=21",
    "cobblemon": ">=1.8.1 <1.9.0"
  }
}
